# Copy to .env and fill in. Every variable here is validated at API boot —
# a missing or malformed value stops the process rather than degrading silently.

NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3000

# --- Postgres -----------------------------------------------------------------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=blender_battle
DATABASE_SSL=false

# --- Redis --------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# --- JWT ----------------------------------------------------------------------
# Must be different from each other and at least 32 chars.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-with-a-48-byte-random-string-access
JWT_REFRESH_SECRET=replace-me-with-a-48-byte-random-string-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Cloudinary ---------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- OAuth (optional) ----------------------------------------------------------
# Each provider is offered only when BOTH of its values are set, so the platform
# runs without registering apps at Discord or Google. Redirect URI to register:
#   <OAUTH_CALLBACK_BASE>/api/v1/auth/oauth/<provider>/callback
OAUTH_CALLBACK_BASE=http://localhost:4000
FRONTEND_URL=http://localhost:3000
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Ops ----------------------------------------------------------------------
LOG_LEVEL=debug
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100

# --- Frontend (NEXT_PUBLIC_* is exposed to the browser; never put secrets here) -
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
