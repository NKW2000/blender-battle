{
  "name": "blender-battle",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --filter @bb/shared build && pnpm --filter \"./apps/*\" build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "//cloudflare": "Cloudflare Workers Builds runs commands from the repo root, where wrangler refuses to act because it cannot tell which workspace project is meant. Both scripts below use --filter so they execute inside apps/web whatever the working directory is.",
    "cf:build": "pnpm --filter @bb/shared build && pnpm --filter @bb/web cf:build",
    "cf:deploy": "pnpm --filter @bb/web exec wrangler deploy",
    "db:migrate": "pnpm --filter @bb/api migration:run",
    "db:revert": "pnpm --filter @bb/api migration:revert",
    "infra:up": "docker compose up -d postgres redis",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
