node_modules/
dist/
build/
.next/
out/
coverage/
*.tsbuildinfo

.env
.env.*
!.env.example
# Tracked on purpose. It holds only NEXT_PUBLIC_* values, which `next build`
# compiles into the browser bundle and are therefore public already — and the
# build needs them from the repository, since a Cloudflare Worker variable is
# bound too late to be inlined.
!apps/web/.env.production

.DS_Store
Thumbs.db
*.log
.pnpm-store/

# Cloudflare. `.open-next/` is the adapted build, regenerated by `pnpm cf:build`
# on every deploy. `.wrangler/` is local state for `wrangler dev`, and
# `cloudflare-env.d.ts` is generated from wrangler.jsonc by `pnpm cf:typegen`.
.open-next/
.wrangler/
cloudflare-env.d.ts
